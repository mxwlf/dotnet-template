<Project>
  <!-- Every production assembly exposes its internals to its own unit test assembly, which is named
       after it with a .tests.unit suffix. This keeps the public API surface limited to what callers
       are meant to use while still letting the tests exercise internal members directly. Test
       projects are skipped because they have no unit test assembly of their own.

       This belongs in Directory.Build.targets rather than Directory.Build.props because both
       $(AssemblyName) and $(IsTestProject) are only final once the project body has been evaluated.
       Directory.Build.props is imported before that, so a project setting its own <AssemblyName>
       would be pointed at the default name instead of the one it chose. -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <InternalsVisibleTo Include="$(AssemblyName).tests.unit" />
  </ItemGroup>
</Project>
